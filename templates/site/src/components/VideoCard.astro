---
import { t, RTL_LANGS } from '../i18n';

interface Props {
	id: string;
	title: string;
	duration: string;
	videoUrl: string;
	steps?: string[];
	href?: string;
	/** Recording variant (e.g. 'mobile'); absent = regular/desktop */
	variant?: string;
	/** Narration language */
	lang?: string;
}

const { id, title, duration, videoUrl, steps = [], href, variant, lang } = Astro.props;
const rtl = RTL_LANGS.includes(lang ?? '');
---

<div class="video-card" data-quickview data-video-url={videoUrl} data-video-id={id} data-variant={variant ?? ''} data-lang={lang ?? ''} lang={lang} dir={rtl ? 'rtl' : undefined}>
	<div class="video-thumbnail">
		{steps.length > 0 ? (
			<div class="step-carousel">
				{steps.map((src, i) => (
					<img
						src={src}
						alt={t(lang, 'step', { n: i + 1 })}
						loading={i === 0 ? 'eager' : 'lazy'}
						class:list={['step-img', { active: i === 0 }]}
					/>
				))}
				{steps.length > 1 && (
					<>
						<button class="step-prev" aria-label={t(lang, 'previousStep')}>‹</button>
						<button class="step-next" aria-label={t(lang, 'nextStep')}>›</button>
						<div class="step-dots">
							{steps.map((_, i) => (
								<span class:list={['step-dot', { active: i === 0 }]}></span>
							))}
						</div>
					</>
				)}
			</div>
		) : (
			<div class="placeholder-thumb"></div>
		)}
		<div class="play-button">▶</div>
	</div>
	<div class="video-info">
		<div class="video-title">{title}</div>
		<div class="video-meta">
			<span class="video-duration">&#x1F550; {duration}</span>
			{variant && <span class="video-variant">{variant === 'mobile' ? '📱 ' : ''}{variant}</span>}
			{href && (
				<a href={href} class="card-page-link" onclick="event.stopPropagation()">→</a>
			)}
		</div>
	</div>
</div>

<script>
	document.querySelectorAll<HTMLElement>('.step-carousel').forEach(carousel => {
		const imgs = carousel.querySelectorAll<HTMLElement>('.step-img');
		const dots = carousel.querySelectorAll<HTMLElement>('.step-dot');
		const prev = carousel.querySelector('.step-prev');
		const next = carousel.querySelector('.step-next');
		const card = carousel.closest('.video-card') as HTMLElement;
		let current = 0;
		let autoMoved = false;
		let timer: ReturnType<typeof setInterval> | null = null;

		const show = (n: number) => {
			imgs[current].classList.remove('active');
			dots[current]?.classList.remove('active');
			current = ((n % imgs.length) + imgs.length) % imgs.length;
			imgs[current].classList.add('active');
			dots[current]?.classList.add('active');
		};

		prev?.addEventListener('click', e => { e.stopPropagation(); show(current - 1); });
		next?.addEventListener('click', e => { e.stopPropagation(); show(current + 1); });
		dots.forEach((dot, i) => dot.addEventListener('click', e => { e.stopPropagation(); show(i); }));

		card?.addEventListener('mouseenter', () => {
			if (imgs.length < 2) return;
			autoMoved = false;
			timer = setInterval(() => { autoMoved = true; show(current + 1); }, 800);
		});
		card?.addEventListener('mouseleave', () => {
			if (timer) { clearInterval(timer); timer = null; }
			if (autoMoved) show(0);
		});
	});
</script>
