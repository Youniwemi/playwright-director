---
// Quick-view player for home cards (`.video-card[data-video-url]`): native modal <dialog>
// (page inert, Esc closes, focus returns to the card), ←/→ and buttons walk the visible
// cards of the same section, the title bar links to the full tutorial page.
// Only a click inside the card's `[data-quickview]` zone opens it (Classic: the whole card; Académie: the
// thumbnail — the text follows the link). A card link keeps working with a modifier key and without JS.
import { t } from '../i18n';

interface Props {
	lang?: string;
}

const { lang: L } = Astro.props;
---

<dialog id="video-modal" class="video-modal" aria-labelledby="video-title">
	<button class="video-modal-close" aria-label={t(L, 'close')}>×</button>
	<div class="video-container">
		<button class="video-nav video-nav-prev" aria-label={t(L, 'previous')}>‹</button>
		<video controls id="modal-video"></video>
		<button class="video-nav video-nav-next" aria-label={t(L, 'next')}>›</button>
	</div>
	<div class="video-title-bar">
		<a id="video-title" href=""></a>
		<span id="video-counter"></span>
	</div>
</dialog>

<script>
	const modal = document.getElementById('video-modal') as HTMLDialogElement | null;
	if (modal) {
		const video = modal.querySelector('video')!;
		const prevBtn = modal.querySelector<HTMLButtonElement>('.video-nav-prev')!;
		const nextBtn = modal.querySelector<HTMLButtonElement>('.video-nav-next')!;
		const titleEl = modal.querySelector<HTMLAnchorElement>('#video-title')!;
		const counterEl = modal.querySelector<HTMLElement>('#video-counter')!;
		let list: HTMLElement[] = [];
		let index = 0;

		const play = (i: number) => {
			if (i < 0 || i >= list.length) return;
			index = i;
			const card = list[i];
			video.src = card.dataset.videoUrl!;
			video.play().catch(() => {});
			titleEl.textContent = card.querySelector('.video-title')?.textContent?.trim() || '';
			titleEl.href = card.dataset.href || card.querySelector<HTMLAnchorElement>('a[href]')?.href || '';
			counterEl.textContent = `${i + 1} / ${list.length}`;
			prevBtn.disabled = i === 0;
			nextBtn.disabled = i === list.length - 1;
		};

		document.addEventListener('click', (e) => {
			// Card controls that must not open the dialog stop propagation themselves
			const card = (e.target as HTMLElement).closest('[data-quickview]')?.closest<HTMLElement>('.video-card[data-video-url]');
			if (!card || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
			e.preventDefault();
			const scope = card.closest('.category') ?? document;
			list = [...scope.querySelectorAll<HTMLElement>('.video-card[data-video-url]')].filter((c) => !c.closest('[hidden]'));
			modal.showModal();
			play(list.indexOf(card));
		});

		// Size the box to the picture (desktop, mobile-variant and portrait recordings differ)
		video.addEventListener('loadedmetadata', () => {
			if (video.videoHeight) modal.style.setProperty('--pd-video-ratio', String(video.videoWidth / video.videoHeight));
		});
		prevBtn.addEventListener('click', () => play(index - 1));
		nextBtn.addEventListener('click', () => play(index + 1));
		video.addEventListener('ended', () => play(index + 1));
		modal.querySelector('.video-modal-close')!.addEventListener('click', () => modal.close());
		// The dialog fills the screen: a click on it (not on its content) is a backdrop click
		modal.addEventListener('click', (e) => {
			if (e.target === modal) modal.close();
		});
		modal.addEventListener('keydown', (e) => {
			if ((e.target as HTMLElement).tagName === 'VIDEO') return;
			const rtl = document.dir === 'rtl';
			if (e.key === 'ArrowLeft') play(index + (rtl ? 1 : -1));
			if (e.key === 'ArrowRight') play(index + (rtl ? -1 : 1));
		});
		modal.addEventListener('close', () => video.pause());
	}
</script>
