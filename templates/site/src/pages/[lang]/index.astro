---
// One home page per extra language (/en/, /ar/ …); the default language lives at /.
import Home from '../../theme/Home.astro';
import { pageLangs } from '../../lib/site';
import { siteLang } from '../../i18n';

export function getStaticPaths() {
	return pageLangs()
		.filter((lang) => lang !== siteLang)
		.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
---

<Home lang={lang} />
